rules_version = '2';

// ACİL DURUM KİLİDİ: TAM KAPALI.
//
// Kimse hiçbir şeyi OKUYAMAZ ya da YAZAMAZ. Okuma kotası bir saldırıyla tükeniyorsa kullanılır: Firestore bu
// istekleri reddeder (reddedilen istekler de kotadan düşebilir, ama veri akışı durur). Site boş görünür ve hata
// şeridi gösterir.
//
// Açmak için: npm run lockdown:closed   Geri almak için: npm run unlock
// (docs/firebase-kurulum.md, "Kota koruması")

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
